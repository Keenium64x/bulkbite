{
  "name": "bulkbite-operations",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:web",
    "build:web": "vite build --mode production",
    "build:mobile": "vite build --mode mobile",
    "mobile:sync": "npm run build:mobile && cap sync",
    "mobile:add:android": "cap add android",
    "mobile:add:ios": "cap add ios",
    "mobile:open:android": "cap open android",
    "mobile:open:ios": "cap open ios",
    "mobile:run:android": "npm run mobile:sync && cap run android",
    "mobile:run:ios": "npm run mobile:sync && cap run ios",
    "mobile:doctor": "cap doctor",
    "test:offline-reconnect": "node scripts/offline-reconnect-proof.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.0",
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.4.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.4.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/network": "^8.0.1",
    "@capacitor/status-bar": "^8.0.3",
    "@dagrejs/dagre": "^3.1.1",
    "@vue-flow/core": "^1.48.2",
    "@vueuse/core": "^14.4.0",
    "@zxing/browser": "^0.1.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "echarts": "^6.1.0",
    "frappe-ui": "^0.1.278",
    "gsap": "^3.15.0",
    "lucide-vue-next": "^1.0.0",
    "reka-ui": "^2.10.4",
    "tailwind-merge": "^3.6.0",
    "vaul-vue": "^0.4.1",
    "vue": "^3.5.13",
    "vue-echarts": "^8.1.0",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "@vitejs/plugin-vue": "^6.0.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^7.3.6"
  },
  "overrides": {
    "echarts": "$echarts"
