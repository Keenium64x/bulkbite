{
  "$schema": "./node_modules/@keenium86x/desyium/schema/desyium.schema.json",
  "schemaVersion": 1,
  "systemVersion": "0.3.1",
  "framework": "vue",
  "packageManager": "npm",
  "aliases": {
    "source": "@"
  },
  "paths": {
    "source": "src",
    "system": "src/desyium",
    "styles": "src/styles/desyium"
  },
  "components": [
    "badge",
    "button",
    "calendar",
    "card",
    "chart",
    "checkbox-shadcn",
    "combobox",
    "date-picker",
    "date-range-picker",
    "date-time-picker",
    "dialog",
    "file-uploader",
    "form-control",
    "link",
    "linked-record-field",
    "list-view",
    "month-picker",
    "multi-file-uploader",
    "multi-select",
    "navigation-menu",
    "operational-button",
    "operational-progress",
    "progress",
    "rating",
    "scan-code-field",
    "select",
    "slider",
    "stat",
    "switch",
    "tabs",
    "text-input",
    "textarea",
    "time-picker",
    "tree"
  ],
  "primitives": [
    "cartesian-grid",
    "focal-glow",
    "grain",
    "tonal-radial"
  ],
  "blocks": [
    "accountant-export",
    "auxiliary-records",
    "bulkbite-app-shell",
    "buying-plan",
    "document-review",
    "employee-management",
    "monthly-planning",
    "price-history",
    "production-measurement",
    "receipt-intake",
    "stock-overview",
    "stock-reconciliation"
  ],
  "theme": "bulkbite-operations",
  "themeSelection": {
    "id": "bulkbite-operations",
    "scope": "project",
    "status": "approved",
    "referenceAcknowledged": true
  },
  "surfaces": [],
  "architecture": {
    "id": "vue-vite",
    "status": "ready"
  },
  "experiences": [
    {
      "id": "entrance-hierarchy",
      "source": "src/experiences/entrance-hierarchy.js",
      "target": "[data-experience-root]",
      "status": "ready",
      "engine": "gsap"
    },
    {
      "id": "flip-layout-transition",
      "source": "src/experiences/bulkbite-nav-expand.js",
      "target": "[data-nav-groups]",
      "status": "ready",
      "engine": "gsap",
      "mountExport": "mountFlipLayoutTransition"
    }
  ],
  "experiencePolicy": null,
  "profile": "vue",
  "preset": "app"
}
