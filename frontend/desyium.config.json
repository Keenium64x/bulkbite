{
  "$schema": "./node_modules/@keenium86x/desyium/schema/desyium.schema.json",
  "schemaVersion": 1,
  "systemVersion": "0.3.1",
  "framework": "vue",
  "packageManager": "npm",
  "aliases": {
    "source": "@"
  },
  "paths": {
    "source": "src",
    "system": "src/desyium",
    "styles": "src/styles/desyium"
  },
  "components": [
    "button",
    "badge",
    "card",
    "dialog",
    "tabs",
    "progress",
    "form-control",
    "text-input",
    "textarea",
    "select",
    "combobox",
    "multi-select",
    "checkbox",
    "switch",
    "slider",
    "rating",
    "date-picker",
    "date-range-picker",
    "date-time-picker",
    "month-picker",
    "time-picker",
    "file-uploader",
    "operational-button",
    "operational-progress",
    "list-view",
    "tree",
    "calendar"
  ],
  "primitives": [
    "tonal-radial",
    "cartesian-grid",
    "focal-glow",
    "grain"
  ],
  "blocks": [],
  "theme": "bulkbite-operations",
  "themeSelection": {
    "id": "bulkbite-operations",
    "scope": "project",
    "status": "approved",
    "referenceAcknowledged": true
  },
  "surfaces": [],
  "architecture": {
    "id": "vue-vite",
    "status": "ready"
  },
  "experiences": [
    {
      "id": "entrance-hierarchy",
      "source": "src/experiences/entrance-hierarchy.js",
      "target": "[data-experience-root]",
      "status": "ready",
      "engine": "gsap"
    }
  ],
  "experiencePolicy": null,
  "profile": "vue",
  "preset": "app"
}
