{
  "apiVersion": "batch/v1",
  "kind": "Job",
  "metadata": {
    "labels": {
      "app.kubernetes.io/name": "site-migrate"
    },
    "name": "site-migrate-__RELEASE_ID__",
    "namespace": "app-bulkbite"
  },
  "spec": {
    "activeDeadlineSeconds": 3600,
    "backoffLimit": 2,
    "completions": 1,
    "parallelism": 1,
    "template": {
      "metadata": {
        "labels": {
          "app.kubernetes.io/name": "site-migrate",
          "app.kubernetes.io/part-of": "bulkbite",
          "poloway.io/database-client": "true",
          "poloway.io/external-client": "true"
        }
      },
      "spec": {
        "automountServiceAccountToken": false,
        "containers": [
          {
            "args": [
              "--site",
              "admin.bulkbite.co.za",
              "migrate"
            ],
            "command": [
              "/usr/local/bin/bench"
            ],
            "image": "__IMAGE__",
            "name": "migrate",
            "resources": {
              "limits": {
                "cpu": "750m",
                "memory": "640Mi"
              },
              "requests": {
                "cpu": "100m",
                "memory": "256Mi"
              }
            },
            "securityContext": {
              "allowPrivilegeEscalation": false,
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              },
              "privileged": false,
              "readOnlyRootFilesystem": true,
              "runAsNonRoot": true
            },
            "volumeMounts": [
              {
                "mountPath": "/home/frappe/frappe-bench/sites",
                "name": "sites"
              },
              {
                "mountPath": "/home/frappe/frappe-bench/logs",
                "name": "logs"
              },
              {
                "mountPath": "/dev/shm",
                "name": "shm"
              }
            ]
          }
        ],
        "imagePullSecrets": [
          {
            "name": "registry-pull"
          }
        ],
        "restartPolicy": "Never",
        "securityContext": {
          "fsGroup": 1000,
          "runAsGroup": 1000,
          "runAsNonRoot": true,
          "runAsUser": 1000,
          "seccompProfile": {
            "type": "RuntimeDefault"
          }
        },
        "serviceAccountName": "app-runtime",
        "volumes": [
          {
            "name": "sites",
            "persistentVolumeClaim": {
              "claimName": "sites"
            }
          },
          {
            "emptyDir": {
              "sizeLimit": "512Mi"
            },
            "name": "logs"
          },
          {
            "emptyDir": {
              "medium": "Memory",
              "sizeLimit": "256Mi"
            },
            "name": "shm"
          }
        ]
      }
    },
    "ttlSecondsAfterFinished": 86400
  }
}
