{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "labels": {
      "app.kubernetes.io/name": "worker-short",
      "app.kubernetes.io/part-of": "bulkbite",
      "poloway.io/database-client": "true",
      "poloway.io/external-client": "true"
    },
    "name": "worker-short",
    "namespace": "app-bulkbite"
  },
  "spec": {
    "progressDeadlineSeconds": 600,
    "replicas": 2,
    "revisionHistoryLimit": 5,
    "selector": {
      "matchLabels": {
        "app.kubernetes.io/name": "worker-short"
      }
    },
    "strategy": {
      "rollingUpdate": {
        "maxSurge": 1,
        "maxUnavailable": 0
      },
      "type": "RollingUpdate"
    },
    "template": {
      "metadata": {
        "labels": {
          "app.kubernetes.io/name": "worker-short",
          "app.kubernetes.io/part-of": "bulkbite",
          "poloway.io/database-client": "true",
          "poloway.io/external-client": "true"
        }
      },
      "spec": {
        "automountServiceAccountToken": false,
        "containers": [
          {
            "args": [
              "worker",
              "--queue",
              "short,default"
            ],
            "command": [
              "/usr/local/bin/bench"
            ],
            "image": "__IMAGE__",
            "livenessProbe": {
              "exec": {
                "command": [
                  "/bin/sh",
                  "-c",
                  "pgrep -f 'bench' >/dev/null"
                ]
              },
              "failureThreshold": 3,
              "initialDelaySeconds": 60,
              "periodSeconds": 60,
              "successThreshold": 1,
              "timeoutSeconds": 5
            },
            "name": "worker",
            "readinessProbe": {
              "exec": {
                "command": [
                  "/bin/sh",
                  "-c",
                  "pgrep -f 'bench' >/dev/null"
                ]
              },
              "failureThreshold": 3,
              "initialDelaySeconds": 15,
              "periodSeconds": 20,
              "successThreshold": 1,
              "timeoutSeconds": 5
            },
            "resources": {
              "limits": {
                "cpu": "750m",
                "memory": "640Mi"
              },
              "requests": {
                "cpu": "100m",
                "memory": "256Mi"
              }
            },
            "securityContext": {
              "allowPrivilegeEscalation": false,
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              },
              "privileged": false,
              "readOnlyRootFilesystem": true,
              "runAsNonRoot": true
            },
            "startupProbe": {
              "exec": {
                "command": [
                  "/bin/sh",
                  "-c",
                  "pgrep -f 'bench' >/dev/null"
                ]
              },
              "failureThreshold": 30,
              "initialDelaySeconds": 10,
              "periodSeconds": 5,
              "successThreshold": 1,
              "timeoutSeconds": 5
            },
            "volumeMounts": [
              {
                "mountPath": "/home/frappe/frappe-bench/sites",
                "name": "sites"
              },
              {
                "mountPath": "/home/frappe/frappe-bench/logs",
                "name": "logs"
              },
              {
                "mountPath": "/dev/shm",
                "name": "shm"
              }
            ]
          }
        ],
        "imagePullSecrets": [
          {
            "name": "registry-pull"
          }
        ],
        "securityContext": {
          "fsGroup": 1000,
          "runAsGroup": 1000,
          "runAsNonRoot": true,
          "runAsUser": 1000,
          "seccompProfile": {
            "type": "RuntimeDefault"
          }
        },
        "serviceAccountName": "app-runtime",
        "volumes": [
          {
            "name": "sites",
            "persistentVolumeClaim": {
              "claimName": "sites"
            }
          },
          {
            "emptyDir": {
              "sizeLimit": "512Mi"
            },
            "name": "logs"
          },
          {
            "emptyDir": {
              "medium": "Memory",
              "sizeLimit": "256Mi"
            },
            "name": "shm"
          }
        ]
      }
    }
  }
}
