{
  "apiVersion": "v1",
  "kind": "Service",
  "metadata": {
    "labels": {
      "app.kubernetes.io/name": "web"
    },
    "name": "web",
    "namespace": "app-bulkbite"
  },
  "spec": {
    "ports": [
      {
        "name": "http",
        "port": 8000,
        "protocol": "TCP",
        "targetPort": "http"
      }
    ],
    "selector": {
      "app.kubernetes.io/name": "web"
    },
    "type": "ClusterIP"
  }
}
