{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "labels": {
      "app.kubernetes.io/name": "web",
      "app.kubernetes.io/part-of": "bulkbite",
      "poloway.io/database-client": "true",
      "poloway.io/external-client": "true"
    },
    "name": "web",
    "namespace": "app-bulkbite"
  },
  "spec": {
    "progressDeadlineSeconds": 600,
    "replicas": 2,
    "revisionHistoryLimit": 5,
    "selector": {
      "matchLabels": {
        "app.kubernetes.io/name": "web"
      }
    },
    "strategy": {
      "rollingUpdate": {
        "maxSurge": 1,
        "maxUnavailable": 0
      },
      "type": "RollingUpdate"
    },
    "template": {
      "metadata": {
        "labels": {
          "app.kubernetes.io/name": "web",
          "app.kubernetes.io/part-of": "bulkbite",
          "poloway.io/database-client": "true",
          "poloway.io/external-client": "true"
        }
      },
      "spec": {
        "automountServiceAccountToken": false,
        "containers": [
          {
            "args": [
              "--chdir=/home/frappe/frappe-bench/sites",
              "--bind=0.0.0.0:8000",
              "--workers=2",
              "--threads=2",
              "--worker-class=gthread",
              "--worker-tmp-dir=/dev/shm",
              "--timeout=120",
              "--access-logfile=-",
              "--error-logfile=-",
              "frappe.app:application"
            ],
            "command": [
              "/home/frappe/frappe-bench/env/bin/gunicorn"
            ],
            "image": "__IMAGE__",
            "livenessProbe": {
              "failureThreshold": 3,
              "httpGet": {
                "httpHeaders": [
                  {
                    "name": "X-Frappe-Site-Name",
                    "value": "admin.bulkbite.co.za"
                  }
                ],
                "path": "/api/method/ping",
                "port": "http",
                "scheme": "HTTP"
              },
              "initialDelaySeconds": 30,
              "periodSeconds": 30,
              "successThreshold": 1,
              "timeoutSeconds": 5
            },
            "name": "web",
            "ports": [
              {
                "containerPort": 8000,
                "name": "http",
                "protocol": "TCP"
              }
            ],
            "readinessProbe": {
              "failureThreshold": 3,
              "httpGet": {
                "httpHeaders": [
                  {
                    "name": "X-Frappe-Site-Name",
                    "value": "admin.bulkbite.co.za"
                  }
                ],
                "path": "/api/method/ping",
                "port": "http",
                "scheme": "HTTP"
              },
              "initialDelaySeconds": 10,
              "periodSeconds": 10,
              "successThreshold": 1,
              "timeoutSeconds": 5
            },
            "resources": {
              "limits": {
                "cpu": "750m",
                "memory": "640Mi"
              },
              "requests": {
                "cpu": "150m",
                "memory": "320Mi"
              }
            },
            "securityContext": {
              "allowPrivilegeEscalation": false,
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              },
              "privileged": false,
              "readOnlyRootFilesystem": true,
              "runAsNonRoot": true
            },
            "startupProbe": {
              "failureThreshold": 30,
              "httpGet": {
                "httpHeaders": [
                  {
                    "name": "X-Frappe-Site-Name",
                    "value": "admin.bulkbite.co.za"
                  }
                ],
                "path": "/api/method/ping",
                "port": "http",
                "scheme": "HTTP"
              },
              "initialDelaySeconds": 5,
              "periodSeconds": 5,
              "successThreshold": 1,
              "timeoutSeconds": 5
            },
            "volumeMounts": [
              {
                "mountPath": "/home/frappe/frappe-bench/sites",
                "name": "sites"
              },
              {
                "mountPath": "/home/frappe/frappe-bench/logs",
                "name": "logs"
              },
              {
                "mountPath": "/dev/shm",
                "name": "shm"
              }
            ]
          }
        ],
        "imagePullSecrets": [
          {
            "name": "registry-pull"
          }
        ],
        "securityContext": {
          "fsGroup": 1000,
          "runAsGroup": 1000,
          "runAsNonRoot": true,
          "runAsUser": 1000,
          "seccompProfile": {
            "type": "RuntimeDefault"
          }
        },
        "serviceAccountName": "app-runtime",
        "volumes": [
          {
            "name": "sites",
            "persistentVolumeClaim": {
              "claimName": "sites"
            }
          },
          {
            "emptyDir": {
              "sizeLimit": "512Mi"
            },
            "name": "logs"
          },
          {
            "emptyDir": {
              "medium": "Memory",
              "sizeLimit": "256Mi"
            },
            "name": "shm"
          }
        ]
      }
    }
  }
}
