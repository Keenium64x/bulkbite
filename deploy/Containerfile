# syntax=docker/dockerfile:1.7

ARG FRAPPE_BUILD_IMAGE=frappe/build:develop@sha256:9a1d11bad8f8668912da65552837b820e328a191417a7892c4c70624160ee76d
ARG FRAPPE_BASE_IMAGE=frappe/base:develop@sha256:4345871bdd1a4cb50e2934ddcbedd87727a4953d567a60b9bfe4b4ae2d6bb1c8

FROM ${FRAPPE_BUILD_IMAGE} AS builder

ARG FRAPPE_REPOSITORY=https://github.com/frappe/frappe.git
ARG FRAPPE_COMMIT=238bcf167028cd98351933ac005786062fb646d0

USER frappe

RUN bench init \
    --frappe-path="${FRAPPE_REPOSITORY}" \
    --frappe-branch=develop \
    --python=python3 \
    --no-procfile \
    --no-backups \
    --skip-redis-config-generation \
    --skip-assets \
    /home/frappe/frappe-bench \
    && cd /home/frappe/frappe-bench/apps/frappe \
    && git fetch --depth 1 upstream "${FRAPPE_COMMIT}" \
    && git checkout --detach "${FRAPPE_COMMIT}" \
    && cd /home/frappe/frappe-bench \
    && ./env/bin/pip install --no-cache-dir -e apps/frappe \
    && yarn --cwd apps/frappe install --frozen-lockfile \
    && echo '{}' > sites/common_site_config.json

COPY --chown=frappe:frappe . /home/frappe/frappe-bench/apps/bulkbite

ENV NODE_OPTIONS=--max-old-space-size=1536

RUN test -s /home/frappe/frappe-bench/apps/bulkbite/bulkbite/public/frontend/index.html \
    && test -s /home/frappe/frappe-bench/apps/bulkbite/bulkbite/www/bulkbite.html \
    && cd /home/frappe/frappe-bench \
    && ./env/bin/pip install --no-cache-dir -e apps/bulkbite \
    && bench build --app frappe --app bulkbite --production \
    && printf 'frappe\nbulkbite\n' > sites/apps.txt \
    && find apps -mindepth 1 -path '*/.git' -prune -exec rm -rf {} + \
    && rm -rf apps/bulkbite/frontend

FROM ${FRAPPE_BASE_IMAGE} AS runtime

USER root

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        poppler-utils \
        tesseract-ocr \
    && rm -rf /var/lib/apt/lists/*

USER frappe

COPY --from=builder --chown=frappe:frappe /home/frappe/frappe-bench /home/frappe/frappe-bench

WORKDIR /home/frappe/frappe-bench

RUN cp -r sites/assets /home/frappe/frappe-bench/assets \
    && rm -rf sites/assets

VOLUME ["/home/frappe/frappe-bench/sites", "/home/frappe/frappe-bench/logs"]

USER root

RUN printf '%s\n' \
    '#!/bin/bash' \
    'set -e' \
    'rm -rf /home/frappe/frappe-bench/sites/assets' \
    'ln -s /home/frappe/frappe-bench/assets /home/frappe/frappe-bench/sites/assets' \
    'exec "$@"' \
    > /usr/local/bin/bulkbite-entrypoint \
    && chmod 755 /usr/local/bin/bulkbite-entrypoint

USER frappe

ENTRYPOINT ["/usr/local/bin/bulkbite-entrypoint"]
CMD ["/home/frappe/frappe-bench/apps/bulkbite/deploy/scripts/start-backend.sh"]
