SITE_NAME=admin.bulkbite.co.za
BULKBITE_IMAGE=bulkbite
BULKBITE_TAG=local
BULKBITE_BIND_ADDRESS=127.0.0.1
BULKBITE_HTTP_PORT=8088

# Generate unique production values. Do not reuse local or example passwords.
DB_ROOT_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_VALUE
ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_VALUE

GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=180
CLIENT_MAX_BODY_SIZE=50m

# Store the Gemini API key in deploy/secrets/gemini_api_key.txt with mode 0600.
# It is mounted only into the one-time site setup container and never enters the image.
